{
	auto_https off
	admin off
	persist_config off
	storage file_system {
		root /tmp/caddy
	}
	servers {
		protocols h1
	}
}

:8080 {
	root * /srv
	encode zstd gzip

	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	try_files {path} /index.html
	file_server
}
