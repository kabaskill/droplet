[Unit]
Description=Droplet Keycloak identity provider
Requires=projects-network.service
After=projects-network.service

[Container]
Image=quay.io/keycloak/keycloak:26.2
ContainerName=droplet-keycloak
Pull=never
Network=projects.network
EnvironmentFile=%h/services/config/droplet/keycloak.env
Volume=droplet-keycloak.volume:/opt/keycloak/data:Z
Volume=%h/services/config/droplet/droplet-realm.json:/opt/keycloak/data/import/droplet-realm.json:ro,Z
Exec=start-dev --import-realm --http-relative-path=/auth --hostname=https://droplet.oguzkabasakal.com/auth --proxy-headers=xforwarded
NoNewPrivileges=true
LogDriver=journald

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=180
TimeoutStopSec=45
MemoryMax=1G
TasksMax=768

[Install]
WantedBy=default.target
