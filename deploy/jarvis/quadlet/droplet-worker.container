[Unit]
Description=Droplet Celery worker
Requires=projects-network.service droplet-postgres.service droplet-redis.service
After=projects-network.service droplet-postgres.service droplet-redis.service

[Container]
Image=localhost/droplet-backend:latest
ContainerName=droplet-worker
Pull=never
Network=projects.network
EnvironmentFile=%h/services/config/droplet/backend.env
Exec=celery -A backend.workers.celery_app.celery_app worker --loglevel=INFO --concurrency=2
NoNewPrivileges=true
ReadOnly=true
Tmpfs=/tmp:rw,nodev,nosuid,size=64m
LogDriver=journald

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=30
MemoryMax=1G
TasksMax=768

[Install]
WantedBy=default.target
